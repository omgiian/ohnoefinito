rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validItem() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'cat', 'note', 'status', 'byUid', 'byName', 'at', 'boughtUid', 'boughtName', 'boughtAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.status in ['out', 'low', 'ok']
        && (!('note' in d) || (d.note is string && d.note.size() <= 120))
        && (!('byName' in d) || d.byName == null || (d.byName is string && d.byName.size() <= 30))
        && (!('boughtName' in d) || d.boughtName == null || (d.boughtName is string && d.boughtName.size() <= 30));
    }

    // Lista condivisa "Casa": accessibile a chi conosce il codice di casa (16 caratteri casuali).
    match /households/{code}/items/{itemId} {
      allow read, delete: if signedIn() && code.matches('^[A-Z0-9]{4}(-[A-Z0-9]{4}){3}$');
      allow create, update: if signedIn() && code.matches('^[A-Z0-9]{4}(-[A-Z0-9]{4}){3}$') && validItem();
    }

    // Lista "Solo mio": ogni telefono vede e modifica solo la propria.
    match /users/{uid}/items/{itemId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && validItem();
    }
  }
}
