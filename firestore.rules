rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Il codice di casa: 16 caratteri casuali, es. ABCD-EFGH-JKLM-NPQR
    function member(code) {
      return signedIn() && code.matches('^[A-Z0-9]{4}(-[A-Z0-9]{4}){3}$');
    }

    function shortText(d, key, max) {
      return d.get(key, null) == null || (d.get(key, null) is string && d.get(key, '').size() <= max);
    }

    // foto del prodotto: solo dai database Open Food/Beauty/Products Facts
    function validImg(d) {
      return d.get('img', null) == null
        || (d.get('img', '') is string && d.get('img', '').size() <= 300
            && d.get('img', '').matches('^https://images[.]open(food|beauty|products)facts[.]org/.*'));
    }

    function validItem() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'cat', 'note', 'status', 'byUid', 'byName', 'at', 'boughtUid', 'boughtName', 'boughtAt', 'pantryId'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.status in ['out', 'low', 'ok']
        && shortText(d, 'note', 120)
        && shortText(d, 'byName', 30)
        && shortText(d, 'boughtName', 30)
        && shortText(d, 'pantryId', 40);
    }

    function validPantry() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'zone', 'qty', 'expiry', 'note', 'barcode', 'img', 'icon', 'byUid', 'byName', 'at', 'updatedAt'])
        && shortText(d, 'icon', 20)
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.zone in ['frigo', 'freezer', 'credenza', 'pulizia', 'bagno']
        && d.qty is int && d.qty >= 0 && d.qty <= 999
        && shortText(d, 'expiry', 10)
        && shortText(d, 'note', 120)
        && shortText(d, 'barcode', 14)
        && validImg(d)
        && shortText(d, 'byName', 30);
    }

    function validBarcode() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'zone', 'cat', 'note', 'img', 'at'])
        && validImg(d)
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && shortText(d, 'zone', 20)
        && shortText(d, 'cat', 20)
        && shortText(d, 'note', 120);
    }

    function validMember() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'avatar', 'color', 'joinedAt', 'lastSeen'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 30
        && shortText(d, 'avatar', 20)
        && shortText(d, 'color', 20);
    }

    // La casa: nome
    match /households/{code} {
      allow read: if member(code);
      allow create, update: if member(code)
        && request.resource.data.keys().hasOnly(['name', 'createdAt', 'updatedAt'])
        && shortText(request.resource.data, 'name', 40);
    }

    // Componenti della casa: ognuno scrive solo il proprio profilo
    match /households/{code}/members/{uid} {
      allow read, delete: if member(code);
      allow create, update: if member(code) && request.auth.uid == uid && validMember();
    }

    // Lista della spesa condivisa "Casa"
    match /households/{code}/items/{itemId} {
      allow read, delete: if member(code);
      allow create, update: if member(code) && validItem();
    }

    // Dispensa condivisa
    match /households/{code}/pantry/{itemId} {
      allow read, delete: if member(code);
      allow create, update: if member(code) && validPantry();
    }

    // Prodotti già riconosciuti dal codice a barre (memoria della casa)
    match /households/{code}/barcodes/{ean} {
      allow read: if member(code);
      allow create, update: if member(code) && ean.matches('^[0-9]{8,14}$') && validBarcode();
    }

    // Nomi e zone dei prodotti letti dagli scontrini (correzioni ricordate)
    match /households/{code}/receiptNames/{key} {
      allow read, delete: if member(code);
      allow create, update: if member(code) && key.size() <= 120
        && request.resource.data.keys().hasOnly(['name', 'zone', 'skip', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.zone in ['frigo', 'freezer', 'credenza', 'pulizia', 'bagno']
        && request.resource.data.skip is bool;
    }

    // Scontrini già importati (per non importarli due volte)
    match /households/{code}/receipts/{id} {
      allow read, delete: if member(code);
      allow create, update: if member(code) && id.size() <= 80
        && request.resource.data.keys().hasOnly(['store', 'date', 'time', 'docNumber', 'total', 'products', 'byUid', 'at']);
    }

    // Iscrizioni alle notifiche push: ognuno salva solo la propria;
    // chiunque in casa può toglierne una scaduta
    match /households/{code}/push/{uid} {
      allow read, delete: if member(code);
      allow create, update: if member(code) && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['endpoint', 'p256dh', 'auth', 'name', 'at'])
        && request.resource.data.endpoint is string && request.resource.data.endpoint.size() <= 800
        && request.resource.data.endpoint.matches('^https://.*')
        && request.resource.data.p256dh is string && request.resource.data.p256dh.size() <= 120
        && request.resource.data.auth is string && request.resource.data.auth.size() <= 40
        && shortText(request.resource.data, 'name', 30);
    }

    // Lista "Solo mio": ogni telefono vede e modifica solo la propria
    match /users/{uid}/items/{itemId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && validItem();
    }
  }
}
